# Copy to .env for `docker compose up` (compose.yml loads it into the commandblock service).
# compose.yml already sets the database, mock OIDC login and backup settings for the local stack,
# so this file only needs overrides. Anything set here that compose.yml also sets is ignored.

# Optional: Docker daemon URI (auto-detected when unset).
# Docker__Endpoint=unix:///var/run/docker.sock
